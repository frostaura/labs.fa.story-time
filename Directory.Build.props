<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Every project, the MAUI head included: zero warnings is a build gate, not a goal. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>FrostAura</Authors>
    <Product>StoryTime (working name)</Product>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
</Project>
