<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- MAUI head exempt: XAML tooling noise -->
    <TreatWarningsAsErrors Condition="'$(MSBuildProjectName)' == 'StoryTime.App'">false</TreatWarningsAsErrors>
    <Authors>FrostAura</Authors>
    <Product>StoryTime (working name)</Product>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
</Project>
