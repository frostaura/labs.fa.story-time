# build output
bin/
obj/
*.user

# native build intermediates (outputs are fetched/built by scripts, not committed)
native/
!scripts/

# models are NEVER in-repo (they live in ~/StoryTimeModels)
*.gguf
*.onnx
voices.bin
espeak-ng-data/

# audio/poster artifacts from local runs
*.wav
*.m4a
!docs/**/*.m4a

# IDE / OS
.vs/
.idea/
.DS_Store

# agent worktrees
.claude/

# Scratch — every temporary artefact (logs, screenshots, captures, reports).
# Emptied at the end of every session; see the tree root CLAUDE.md "Scratch" section.
.tmp/
