<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mac voice-lab harness: plans a story with the real SoothingPlanner, mixes per-utterance
       PCM rendered by render-utterances.swift (macOS AVSpeechSynthesizer) through the real
       SoothingNarrator chain, and measures the result. See README.md beside this file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StoryTime.NarrationLab</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../app/StoryTime.Core/StoryTime.Core.csproj" />
  </ItemGroup>

</Project>
