<Project>
  <!--
    Desktop natives for headless pipeline runs on the dev Mac.
    llama.cpp dylibs come from scripts/build-native.sh (macos target) via
    $(STORYTIME_NATIVE_ROOT), defaulting to $(HOME)/StoryTimeNative — always
    OUTSIDE the iCloud-synced tree. sherpa-onnx natives arrive via the
    org.k2fsa.sherpa.onnx runtime NuGet packages referenced by Core.
  -->
  <PropertyGroup>
    <STORYTIME_NATIVE_ROOT Condition="'$(STORYTIME_NATIVE_ROOT)' == ''">$(HOME)/StoryTimeNative</STORYTIME_NATIVE_ROOT>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(STORYTIME_NATIVE_ROOT)/osx-arm64')">
    <None Include="$(STORYTIME_NATIVE_ROOT)/osx-arm64/*.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
</Project>
