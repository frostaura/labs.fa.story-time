# poster.gbnf - GBNF grammar constraining PosterSpec JSON emission (formation contract v2).
# ONLY the curated PosterPalette / PosterShape enum strings are producible, exactly 4 layers
# with fixed depths 0..3 (back -> front), 0-3 elements per layer (12 max keeps the stage
# inside its 700-token generation budget). ASCII-locked.
root ::= "{\"palette\":" palette ",\"mood\":" mood ",\"layers\":[" layer0 "," layer1 "," layer2 "," layer3 "],\"seed\":" int "}"

palette ::= "\"NightHarbor\"" | "\"MoonMeadow\"" | "\"OceanDeep\"" | "\"PlumDusk\"" | "\"PineForest\"" | "\"CloudDrift\"" | "\"StarfieldViolet\"" | "\"LanternGlow\"" | "\"TidePool\"" | "\"SnowHush\"" | "\"EmberSky\"" | "\"MistValley\""

shape ::= "\"Moon\"" | "\"Stars\"" | "\"Hills\"" | "\"Water\"" | "\"Cloud\"" | "\"Pine\"" | "\"FoxSilhouette\"" | "\"Lighthouse\"" | "\"Boat\"" | "\"WindowGlow\"" | "\"Crescent\"" | "\"StarCluster\"" | "\"ShootingStar\"" | "\"MistBand\"" | "\"Aurora\"" | "\"Snowfall\"" | "\"FireflyScatter\"" | "\"Mountain\"" | "\"ForestRow\"" | "\"Path\"" | "\"RoundTree\"" | "\"Reeds\"" | "\"FlowerScatter\"" | "\"Sailboat\"" | "\"Lantern\"" | "\"Tent\"" | "\"Rabbit\"" | "\"Owl\"" | "\"BirdFlock\"" | "\"DeerSilhouette\"" | "\"WhaleTail\""

mood ::= "\"calm\"" | "\"dreamy\"" | "\"cozy\"" | "\"gentle\"" | "\"wonder\"" | "\"sleepy\""

layer0 ::= "{\"depth\":0,\"elements\":" elements "}"
layer1 ::= "{\"depth\":1,\"elements\":" elements "}"
layer2 ::= "{\"depth\":2,\"elements\":" elements "}"
layer3 ::= "{\"depth\":3,\"elements\":" elements "}"

elements ::= "[]" | "[" element ("," element){0,2} "]"
element ::= "{\"shape\":" shape ",\"x\":" num ",\"y\":" num ",\"scale\":" num ",\"density\":" num ",\"tint\":" num ",\"glow\":" num ",\"flipX\":" bool "}"

bool ::= "true" | "false"

# numbers clamped to 0..1 by construction: 0, 1, or 0.xxx
num ::= "0" | "1" | "0." [0-9] [0-9]? [0-9]?
int ::= [1-9] [0-9]{0,5}
