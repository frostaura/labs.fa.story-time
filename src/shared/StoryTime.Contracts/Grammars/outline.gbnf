# outline.gbnf — GBNF grammar constraining StoryOutline JSON emission.
# Compact JSON (no whitespace) keeps token count low and parsing deterministic.
# Keys are lowercase; parser uses PropertyNameCaseInsensitive.
# Bounds: 2-4 settings, 1-4 characters, 3-10 scenes, 2-4 beats per scene.
root ::= "{\"title\":" string ",\"moral\":" string ",\"settings\":" settings ",\"characters\":" characters ",\"scenes\":" scenes "}"

settings ::= "[" string ("," string){0,3} "]"

characters ::= "[" character ("," character){0,3} "]"
character ::= "{\"name\":" string ",\"kind\":" string ",\"trait\":" string "}"

scenes ::= "[" scene ("," scene){2,9} "]"
scene ::= "{\"id\":" int ",\"summary\":" string ",\"beats\":" beats "}"
beats ::= "[" string ("," string){1,3} "]"

# printable ASCII only (excluding " and \) — blocks multilingual token leakage into JSON fields
string ::= "\"" char{2,140} "\""
char ::= [\x20-\x21\x23-\x5B\x5D-\x7E] | "\\" ["\\bfnrt]
int ::= [0-9] | [1-9] [0-9]
