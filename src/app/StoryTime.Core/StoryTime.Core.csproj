<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StoryTime.Core</RootNamespace>
    <!-- Engines/Llama/LlamaNative.cs (native-AI agent) uses pointer marshalling -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <!-- bundle_green lifts the NU1903 advisory on sqlite-net-pcl's transitive raw bundle -->
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <!-- SherpaTtsEngine (Engines/Sherpa): managed C# wrapper over sherpa-onnx C API.
         Pulls RID-specific native runtimes (osx-arm64 desktop, android-arm64) automatically;
         no iOS natives exist in this package — iOS uses the platform-TTS fallback for now. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/StoryTime.Contracts/StoryTime.Contracts.csproj" />
  </ItemGroup>

</Project>
