<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:StoryTime.App.Services">

    <!-- Hearth implicit + keyed styles. No cards, no gradients; hairlines + one honey accent. -->

    <!-- Anticipatory haptics (founder pass 2026-07-31): every button answers the finger at
         POINTER-DOWN via the attached PressHaptics.OnPressed setter carried by each button
         style below — never per-page markup. The command-level haptic that follows (nav
         Light etc.) coalesces away in PlatformHaptics. Disabled buttons never raise
         Pressed, so the press haptic respects IsEnabled by construction. -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource BgPhone}" />
        <Setter Property="Background" Value="{StaticResource BgPhoneBrush}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource BgPhone}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource Cream}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource Cream}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource BgPhone}" />
        <Setter Property="BarTextColor" Value="{StaticResource Cream}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="FontFamily" Value="QuicksandRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Display: Outfit Light, large -->
    <Style x:Key="Display" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="FontFamily" Value="OutfitLight" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="LineHeight" Value="1.12" />
    </Style>

    <Style x:Key="DisplaySmall" TargetType="Label" BasedOn="{StaticResource Display}">
        <Setter Property="FontSize" Value="28" />
    </Style>

    <!-- Eyebrow: Outfit Medium 11, tracked, uppercase (text supplied in caps) -->
    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Faint}" />
        <Setter Property="FontFamily" Value="OutfitMedium" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.8" />
    </Style>

    <Style x:Key="EyebrowAccent" TargetType="Label" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
    </Style>

    <!-- Body: Quicksand, muted, roomy line-height -->
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="QuicksandRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.65" />
    </Style>

    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Faint}" />
    </Style>

    <Style x:Key="Whisper" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Dim}" />
    </Style>

    <Style x:Key="UiText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="FontFamily" Value="OutfitRegular" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Hairline divider -->
    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource Hairline}" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!-- Amber CTA: radius 14, height 56, Outfit Medium 16, ink text, soft pressed glow -->
    <Style TargetType="Button">
        <Setter Property="services:PressHaptics.OnPressed" Value="Light" />
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource InkOnAccent}" />
        <Setter Property="FontFamily" Value="OutfitMedium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentHover}" />
                            <Setter Property="Shadow">
                                <Shadow Brush="{StaticResource AccentBrush}" Radius="26" Opacity="0.45" Offset="0,0" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
                            <Setter Property="TextColor" Value="{StaticResource Dim}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Outlined amber button -->
    <Style x:Key="OutlinedButton" TargetType="Button">
        <Setter Property="services:PressHaptics.OnPressed" Value="Light" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="FontFamily" Value="OutfitMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="BorderColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
                            <Setter Property="TextColor" Value="{StaticResource AccentHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Dim}" />
                            <Setter Property="BorderColor" Value="{StaticResource Border}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Quiet text-only button. DEPRECATED as an affordance (founder pass 2026-07-31:
         "buttons like back, adjust and so on are very much not obvious"). Kept only for
         genuinely non-essential footer text; every real secondary action uses a Pill*
         style below. Text lifted Faint → Muted so a stray one is still legible. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="services:PressHaptics.OnPressed" Value="Light" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="OutfitRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Accent}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ==========================================================================
         The affordance system (founder pass 2026-07-31).

         Hearth is quiet by design, but secondary actions had gone TOO quiet: bare
         Faint/Dim text with no container, no touch target and no pressed state.
         Every secondary action now wears a PILL — a 1px hairline-stroke capsule,
         44dp tall (40 compact), 16–20dp horizontal padding — with Cream or Accent
         text. Pressed fills SurfaceRaised and turns the text Accent. Haptics fire at
         pointer-down (PressHaptics.OnPressed, carried by the style); the command's own
         haptic (ShellNavigator's nav Light) coalesces away.

         Rule this encodes: Dim/Faint is NEVER the sole signal that something is
         interactive. Clearly a button, still a whisper.
         ========================================================================== -->

    <!-- Neutral secondary action: hairline capsule, Cream text. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="services:PressHaptics.OnPressed" Value="Light" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="FontFamily" Value="OutfitMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
                            <Setter Property="BorderColor" Value="{StaticResource Accent}" />
                            <Setter Property="TextColor" Value="{StaticResource Accent}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Dim}" />
                            <Setter Property="BorderColor" Value="{StaticResource Hairline}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- The same capsule, Accent text: the action you actually want found
         ("Adjust ›", "All ›", "UPGRADE →", "☾ Kid Shelf"). -->
    <Style x:Key="PillButtonAccent" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
                            <Setter Property="BorderColor" Value="{StaticResource Accent}" />
                            <Setter Property="TextColor" Value="{StaticResource AccentHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Dim}" />
                            <Setter Property="BorderColor" Value="{StaticResource Hairline}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Compact variants for header rows, where a 44dp capsule beside an 11px
         eyebrow reads heavy. 40dp still clears a comfortable thumb. -->
    <Style x:Key="PillButtonCompact" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="PillButtonAccentCompact" TargetType="Button" BasedOn="{StaticResource PillButtonAccent}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Back. One pill, one position (top-left of the header row) on every screen
         that has one — the mini-bar owns the bottom edge, so back cannot live there.
         Text is always "‹  Back": a chevron alone is not a button. -->
    <Style x:Key="BackPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Text" Value="‹  Back" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- A row's trailing value + chevron, when the whole row navigates. Accent, not
         Dim — the colour IS the affordance on a row with no container of its own. -->
    <Style x:Key="RowValue" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="FontFamily" Value="OutfitRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Inline tappable whisper (premium hints, the debug unlock row): still small,
         never Dim. Accent carries the "this does something" signal. -->
    <Style x:Key="TappableWhisper" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="FontFamily" Value="OutfitMedium" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Cream}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Dim}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OutfitLight" />
        <Setter Property="FontSize" Value="26" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Accent}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource Accent}" />
    </Style>

</ResourceDictionary>
