<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StoryTime.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StoryTime.App.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="StoryTime">

    <!-- Single Shell root; every other screen is a registered push/modal route
         (architecture section 12 - no push route name collides with "home"). -->
    <ShellContent
        Title="Home"
        Route="home"
        ContentTemplate="{DataTemplate views:HomePage}" />

</Shell>
