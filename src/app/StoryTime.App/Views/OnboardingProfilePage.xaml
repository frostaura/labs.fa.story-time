<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StoryTime.App.Views.OnboardingProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StoryTime.Core.ViewModels;assembly=StoryTime.Core"
    x:DataType="vm:OnboardingProfileViewModel"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto" Padding="32,24,32,28">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <Label Style="{StaticResource Eyebrow}" Text="STORYTIME · 1 OF 3" Margin="0,24,0,28" />

                <Label Style="{StaticResource Display}" Text="Who's listening tonight?" />
                <Label Style="{StaticResource Body}" Margin="0,10,0,36"
                       Text="It all stays on this phone. Never on our servers." />

                <Label Style="{StaticResource Eyebrow}" Text="NICKNAME" Margin="0,0,0,2" />
                <Entry x:Name="NicknameEntry" Placeholder="Their name"
                       Text="{Binding Nickname}" />
                <BoxView Color="{StaticResource Border}" Margin="0,2,0,32" />

                <Label Style="{StaticResource Eyebrow}" Text="AGE" Margin="0,0,0,10" />
                <HorizontalStackLayout x:Name="AgeRow" Spacing="26" Margin="0,0,0,32" />

                <Label Style="{StaticResource Eyebrow}" Text="THEY LOVE" Margin="0,0,0,4" />
                <VerticalStackLayout x:Name="InterestList" Spacing="0" />

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1" Margin="0,16,0,0" Text="Continue →"
                Command="{Binding ContinueCommand}" />
    </Grid>
</ContentPage>
