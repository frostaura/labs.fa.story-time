<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StoryTime.App.Views.ContentFiltersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:StoryTime.Core.ViewModels;assembly=StoryTime.Core"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:StoryTime.App.Views"
    x:Name="Page"
    x:DataType="vm:ContentFiltersViewModel"
    Shell.NavBarIsVisible="False">

    <!-- Pushed from Parent settings — inside the biometric-gated flow, no extra gate. -->
    <Grid RowDefinitions="*" Padding="32,24,32,28">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- Back: shared pill, top-left, same as every other screen. -->
                <Button Style="{StaticResource BackPill}" Command="{Binding CloseCommand}" Margin="0,4,0,0" />

                <Label Style="{StaticResource Eyebrow}" Text="STORYTIME · CONTENT FILTERS" Margin="0,26,0,28" />

                <Label Style="{StaticResource Display}" Text="How adventurous tonight?" />
                <Label Style="{StaticResource Body}" Margin="0,10,0,32"
                       Text="Pick the feel of new stories. Older kids can carry a little more wonder." />

                <!-- Level rows — radio pattern like the narrator picker (selected = amber). -->
                <Grid x:Name="GentleRow" ColumnDefinitions="Auto,*" HeightRequest="72">
                    <Grid.Behaviors>
                        <!-- Radio row: Selection at POINTER-DOWN (anticipatory rule), before
                             the VM commits and repaints the dots — the VM's own Selection
                             then coalesces away inside PlatformHaptics. -->
                        <toolkit:TouchBehavior
                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectGentleCommand, x:DataType=views:ContentFiltersPage}"
                            CurrentTouchStatusChanged="OnPressDownSelection"
                            PressedBackgroundColor="{StaticResource SurfaceRaised}"
                            DefaultBackgroundColor="Transparent"
                            PressedAnimationDuration="60" DefaultAnimationDuration="120" />
                    </Grid.Behaviors>
                    <Label x:Name="GentleDot" Grid.Column="0" Text="●" FontSize="10"
                           VerticalOptions="Center" Margin="0,0,12,0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="GentleTitle" Text="Gentle" FontFamily="OutfitRegular" FontSize="17" />
                        <Label Style="{StaticResource Caption}" Text="Soft wonder only. Nothing scary, ever." />
                    </VerticalStackLayout>
                </Grid>
                <BoxView />
                <Grid x:Name="BraveishRow" ColumnDefinitions="Auto,*" HeightRequest="72">
                    <Grid.Behaviors>
                        <toolkit:TouchBehavior
                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectBraveishCommand, x:DataType=views:ContentFiltersPage}"
                            CurrentTouchStatusChanged="OnPressDownSelection"
                            PressedBackgroundColor="{StaticResource SurfaceRaised}"
                            DefaultBackgroundColor="Transparent"
                            PressedAnimationDuration="60" DefaultAnimationDuration="120" />
                    </Grid.Behaviors>
                    <Label x:Name="BraveishDot" Grid.Column="0" Text="●" FontSize="10"
                           VerticalOptions="Center" Margin="0,0,12,0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="BraveishTitle" Text="Brave-ish" FontFamily="OutfitRegular" FontSize="17" />
                        <Label Style="{StaticResource Caption}"
                               Text="Tiny thrills on gentle quests. Still nothing scary, ever." />
                    </VerticalStackLayout>
                </Grid>
                <BoxView />

                <Label Style="{StaticResource Whisper}" HorizontalTextAlignment="Center" Margin="0,28,0,8"
                       Text="Every level keeps the same hard safety rules. This only changes how adventurous the stories feel." />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
